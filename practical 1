#include <stdio.h>
int main() {
    int arr[10] = {10, 20, 30, 40, 50};  
    int n = 5;   
    int i, pos, value, found;

    printf("Original array: ");
    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    value = 25;
    pos = 2;

    for (i = n; i > pos; i--) {
        arr[i] = arr[i - 1];   
    }
    arr[pos] = value;
    n++;

    printf("After inserting %d at position %d: ", value, pos);
    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    pos = 1;

    for (i = pos; i < n - 1; i++) {
        arr[i] = arr[i + 1];  
    }
    n--;

    printf("After deleting element at position %d: ", pos);
    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    value = 40;
    found = -1;

    for (i = 0; i < n; i++) {
        if (arr[i] == value) {
            found = i;
            break;
        }
    }

    if (found != -1) {
        printf("Element %d found at position %d.\n", value, found);
    } else {
        printf("Element %d not found.\n", value);
    }

    return 0;
}
