#include <stdio.h>
#define MAX 5   // maximum size of stack

int stack[MAX];
int top = -1;    // -1 means stack is empty

// PUSH operation
void push(int value) {
    if (top == MAX - 1) {
        printf("Stack Overflow! Cannot push %d\n", value);
        return;
    }
    top++;
    stack[top] = value;
    printf("Pushed %d\n", value);
}

// POP operation
void pop() {
    if (top == -1) {
        printf("Stack Underflow! Stack is empty\n");
        return;
    }
    printf("Popped %d\n", stack[top]);
    top--;
}

// PEEK operation
void peek() {
    if (top == -1) {
        printf("Stack is empty\n");
        return;
    }
    printf("Top element is %d\n", stack[top]);
}

// DISPLAY operation
void display() {
    if (top == -1) {
        printf("Stack is empty\n");
        return;
    }
    printf("Stack elements: ");
    for (int i = top; i >= 0; i--) {
        printf("%d ", stack[i]);
    }
    printf("\n");
}

int main() {
    push(10);
    push(20);
    push(30);
    display();   // Stack elements: 30 20 10

    peek();      // Top element is 30

    pop();       // Popped 30
    display();   // Stack elements: 20 10

    push(40);
    push(50);
    push(60);    // Stack Overflow (MAX = 5, already have 4 elements)

    display();

    return 0;
}
